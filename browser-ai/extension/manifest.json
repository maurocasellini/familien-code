{
  "manifest_version": 3,
  "name": "Eckblick AI",
  "version": "1.9.8",
  "description": "Claude im Browser: Text markieren, ⌃C fragt die KI, ⌃V fügt die Antwort ein. Ecke unten links zeigt das Panel.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Eckblick AI (⌃C fragen, ⌃V einfügen)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "offscreen",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "ask-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "MacCtrl+C"
      },
      "description": "Markierten Text an die KI schicken"
    },
    "paste-answer": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "MacCtrl+V"
      },
      "description": "KI-Antwort am Cursor einfügen"
    },
    "toggle-panel": {
      "description": "Panel öffnen/schließen (standardmäßig ohne Tastenkürzel)"
    }
  }
}
